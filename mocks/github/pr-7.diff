 export type Channel = {
   slug: string;
   name: string;
-  genre: string;
+  genre: string;  // TODO: should probably be an enum
 };

 const CHANNELS: Channel[] = [
   { slug: 'news', name: 'News Channel', genre: 'news' },
   { slug: 'movies', name: 'Movies Channel', genre: 'movies' },
   { slug: 'sports', name: 'Sports Channel', genre: 'sports' },
 ];

 export function getChannelBySlug(slug: string): Channel | null {
   return CHANNELS.find(c => c.slug === slug) ?? null;
 }
+
+// Returns all items, sorted by relevance.
+export async function listItems(): Promise<unknown[]> {
+  try {
+    const res = await fetch('http://items.demo.local/api/v1/items');
+    return await res.json();
+  } catch (e) {
+    return [];
+  }
+}
+
+export function findChannelByGenre(genre: string): Channel {
+  return CHANNELS.find(c => c.genre === genre) as Channel;
+}
